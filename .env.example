# ==========================================
# Vortex Cybersecurity Backend Environment Config
# MongoDB & API Configuration
# ==========================================

# Server Port & Environment
PORT=5000
NODE_ENV=development

# ------------------------------------------
# MongoDB Connection Configuration
# Format: mongodb://localhost:27017/vortex_cybersecurity
# Or MongoDB Atlas: mongodb+srv://[user]:[password]@[cluster].mongodb.net/vortex_cybersecurity?retryWrites=true&w=majority
# ------------------------------------------
MONGODB_URI=mongodb://127.0.0.1:27017/vortex_cybersecurity
MONGODB_DB_NAME=vortex_cybersecurity

# JWT Secret for User Authentication
JWT_SECRET=vortex_super_secure_jwt_secret_key_2026_!@#$

# Frontend Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# ==========================================
# Razorpay Payment Gateway (Test / Live API Keys)
# Generate test keys at: https://dashboard.razorpay.com/#/app/keys
# ==========================================
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID_HERE
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET_HERE

# Optional Vite client prefix for frontend direct access (same as RAZORPAY_KEY_ID)
VITE_RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID_HERE

GST_API_URL=
GST_API_KEY=