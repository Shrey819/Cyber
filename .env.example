# ==========================================
# Neon PostgreSQL & Backend Environment Config
# ==========================================

# Server Port
PORT=5000
NODE_ENV=development

# ------------------------------------------
# Paste your Neon Connection String below:
# Format: postgresql://[user]:[password]@[endpoint].neon.tech/[dbname]?sslmode=require
# ------------------------------------------
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD_HERE@ep-your-endpoint-name.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# JWT Secret for User Authentication
JWT_SECRET=vortex_super_secure_jwt_secret_key_2026_!@#$

# Frontend Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# ==========================================
# Razorpay Payment Gateway (Test / Live API Keys)
# Generate test keys at: https://dashboard.razorpay.com/#/app/keys
# ==========================================
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID_HERE
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET_HERE

# Optional Vite client prefix for frontend direct access (same as RAZORPAY_KEY_ID)
VITE_RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID_HERE

